# Copy this file to .env and fill it in. .env is git-ignored.

# Event stream to consume
STREAM_URL=ws://localhost:8765

# Triage engine: "rules" (free, no API calls) or "openai"
TRIAGE=rules

# OpenAI (only used when TRIAGE=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=none

# Price per 1M tokens for the model above, used for the spend meter and budget cap
OPENAI_PRICE_INPUT_PER_1M=0.75
OPENAI_PRICE_OUTPUT_PER_1M=4.50

# Hard spend cap per run. Once reached, triage falls back to rules.
LLM_BUDGET_USD=1.00

# Seconds before an AI call is abandoned and rules take over
LLM_TIMEOUT_S=10

# Failure injection for demos: off | slow | 429 | junk | flaky
LLM_CHAOS=off

# Local time zone of the monitored sites, given to the AI as context
SITE_TIMEZONE=America/New_York
